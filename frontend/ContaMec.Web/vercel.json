{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/contamec-web",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:js|css|map|json|webmanifest|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|txt)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(ngsw-worker\\.js|safety-worker\\.js|worker-basic\\.min\\.js|ngsw\\.json|index\\.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
