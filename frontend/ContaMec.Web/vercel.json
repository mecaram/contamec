{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/contamec-web",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:js|css|map|json|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|txt)$).*)",
      "destination": "/index.html"
    }
  ]
}
